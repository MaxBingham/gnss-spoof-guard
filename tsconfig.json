{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "types": ["node"]
  },
  "include": [
    "sim/**/*.ts",
    "sensors/**/*.ts",
    "estimation/**/*.ts",
    "pipeline/**/*.ts",
    "ui/**/*.ts",
    "vitest.config.ts"
  ]
}
